# Copy this file to .env and fill the values
PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxx.mongodb.net/tswal?retryWrites=true&w=majority
ALLOWED_ORIGINS=http://localhost:3000,https://your-prod-domain.com

# Firebase Admin SDK (required for JWT verification)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
